{
  "expo": {
    "name": "WorkshopPM",
    "slug": "electro-pimentel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "workshoppm",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/a6a5e624-d541-413b-9b0c-35172bc891de"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 1,
      "package": "com.tudominio.workshoppm",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "dist",
      "favicon": "./assets/images/favicon.png",
      "build": {
        "babel": {
          "include": [
            "node_modules/expo-router"
          ]
        }
      }
    },
    "extra": {
      "eas": {
        "projectId": "a6a5e624-d541-413b-9b0c-35172bc891de"
      }
    },
    "plugins": [
      "expo-router",
      {
        "origin": "https://workshop-a3u1jiax2-sonny-pimentel-mogrovejos-projects.vercel.app"
      },
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "build": {
      "babel": {
        "include": [
          "react-native-svg"
        ]
      }
    },
    "owner": "thegrozzo",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
