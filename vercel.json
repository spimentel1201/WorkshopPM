{
    "version": 2,
    "builds": [
      {
        "src": "*.js",
        "use": "@vercel/static-build",
        "config": {
          "distDir": "dist"
        }
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "/index.html"
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      { "source": "/_expo/(.*)", "destination": "/_expo/$1" },
      { "source": "/static/(.*)", "destination": "/static/$1" },
      { "source": "/(.*)", "destination": "/index.html" }
    ]
}